#pragma once

// Generated into the build directory by port/CMakeLists.txt's
// configure_file. The value comes from the `STORMHOLD_VERSION` cache
// variable, which a local build leaves at its "-dev" default and which the
// release workflow sets from the git tag (with the "stormhold-v" prefix
// stripped) -- so what the launcher shows in its corner is always the
// build it actually is, with no file to remember to bump by hand.
//
// The same value decides whether this build offers updates at all. A
// "-dev" version does not (see updater.h): its install is a build tree,
// and dropping a release on top of it would overwrite work in progress.

#define STORMHOLD_LAUNCHER_VERSION "@STORMHOLD_VERSION@"
#define STORMHOLD_LAUNCHER_VERSION_W L"@STORMHOLD_VERSION@"

// Where the launcher looks for newer builds, and the tag prefix that
// distinguishes Stormhold's releases from Dawnstar's/Oblivion's in the
// same repo (see update_check.h). Cache variables so a fork updates from
// its own repository without editing source.
#define STORMHOLD_UPDATE_OWNER "@STORMHOLD_UPDATE_OWNER@"
#define STORMHOLD_UPDATE_REPO "@STORMHOLD_UPDATE_REPO@"
#define STORMHOLD_UPDATE_TAG_PREFIX "@STORMHOLD_UPDATE_TAG_PREFIX@"
