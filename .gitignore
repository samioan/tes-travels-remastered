# --- Copyrighted game data ---
# Never commit the original .jar releases or anything extracted straight
# from them (art, audio, level/script data, the class files themselves).
/roms/*.jar
/dawnstar/extracted/
/oblivion/extracted/
/stormhold/extracted/

# --- Third-party tooling ---
# Not project source; fetched locally, not tracked in git.
/tools/vineflower.jar
/tools/midp-stubs/

# --- Python ---
__pycache__/
*.pyc

# --- PC port build output (regenerable via port/build.bat / CMake) ---
/dawnstar/port/build/
/dawnstar/port/build-dist/
/dawnstar/port/dist/
/oblivion/port/build/
/stormhold/port/build/
/stormhold/port/build-dist/
/stormhold/port/dist/
*.log
