# --- Copyrighted game data ---
# Never commit the original .jar releases or anything extracted straight
# from them (art, audio, level/script data, the class files themselves).
/roms/*.jar
/dawnstar/extracted/
/oblivion/extracted/
/stormhold/extracted/

# --- Copyrighted device firmware ---
# Ceurope.gdr/Browsereur.gdr are the Nokia 3650's own ROM fonts (see each
# port's src/graphics/bitmap_font.h) -- Nokia's, not this project's. Never
# commit them; each dev copies their own into port/assets/fonts/ (from a
# device dump, EKA2L1, or Nokia's Series 60 MIDP SDK emulator's
# epoc32/release/wins/udeb/z/system/fonts/).
/dawnstar/port/assets/fonts/
/stormhold/port/assets/fonts/

# --- Third-party tooling ---
# Not project source; fetched locally, not tracked in git.
/tools/vineflower.jar
/tools/midp-stubs/

# --- Python ---
__pycache__/
*.pyc

# --- PC port build output (regenerable via port/build.bat / CMake) ---
/dawnstar/port/build/
/dawnstar/port/build-dist/
/dawnstar/port/dist/
/oblivion/port/build/
/stormhold/port/build/
/stormhold/port/build-dist/
/stormhold/port/dist/
*.log
